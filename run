#!/usr/bin/env bash
# IWANTAJOB runner. Usage:
#   ./run              # start backend + frontend in FOREGROUND, stream logs (Ctrl-C stops both)
#   ./run up           # alias
#   ./run up --bg      # start in background (old behavior)
#   ./run lan          # like `up` but binds 0.0.0.0 so iPad/other devices on same Wi-Fi can use it
#   ./run down         # stop both
#   ./run restart      # down + up --bg
#   ./run logs         # tail backgrounded logs
#   ./run status       # show what's running + env presence
#   ./run open         # open the frontend in browser

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

BACK_LOG="/tmp/iwantajob-backend.log"
FRONT_LOG="/tmp/iwantajob-frontend.log"
BACK_PIDFILE="/tmp/iwantajob-backend.pid"
FRONT_PIDFILE="/tmp/iwantajob-frontend.pid"

if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.env"
  set +a
fi

color() { printf "\033[%sm%s\033[0m" "$1" "$2"; }
ok()    { color "32" "✓ $*"; echo; }
err()   { color "31" "✗ $*"; echo; }
info()  { color "36" "› $*"; echo; }

_running() {
  local pidfile="$1"
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null
}

_check_venv() {
  if [ ! -x "$ROOT/scraper/.venv/bin/jobscraper" ]; then
    err "venv missing at scraper/.venv. Setup: cd scraper && python -m venv .venv && .venv/bin/pip install -e ."
    exit 1
  fi
}

start_backend_bg() {
  if _running "$BACK_PIDFILE"; then ok "backend already up (pid $(cat $BACK_PIDFILE))"; return; fi
  _check_venv
  info "starting backend on :8000 (bg)"
  ( cd "$ROOT/scraper" && setsid .venv/bin/jobscraper serve --host 127.0.0.1 --port 8000 \
      > "$BACK_LOG" 2>&1 < /dev/null & echo $! > "$BACK_PIDFILE" )
  for i in $(seq 1 15); do
    if curl -sf http://127.0.0.1:8000/api/health > /dev/null; then
      ok "backend  http://127.0.0.1:8000"; return
    fi
    if ! _running "$BACK_PIDFILE"; then
      err "backend crashed during startup. Last 40 lines of $BACK_LOG:"
      tail -n 40 "$BACK_LOG" || true
      exit 1
    fi
    sleep 1
  done
  err "backend slow / unhealthy. Tail $BACK_LOG:"
  tail -n 40 "$BACK_LOG" || true
  exit 1
}

start_frontend_bg() {
  if _running "$FRONT_PIDFILE"; then ok "frontend already up (pid $(cat $FRONT_PIDFILE))"; return; fi
  info "starting frontend on :3000 (bg)"
  if [ ! -d "$ROOT/web/node_modules" ]; then
    info "installing web deps (first run)…"
    ( cd "$ROOT/web" && npm install --silent )
  fi
  ( cd "$ROOT/web" && setsid npm run dev > "$FRONT_LOG" 2>&1 < /dev/null & echo $! > "$FRONT_PIDFILE" )
  for i in $(seq 1 45); do
    if curl -sf http://127.0.0.1:3000 > /dev/null; then
      ok "frontend http://127.0.0.1:3000"; return
    fi
    if ! _running "$FRONT_PIDFILE"; then
      err "frontend crashed during startup. Last 40 lines of $FRONT_LOG:"
      tail -n 40 "$FRONT_LOG" || true
      exit 1
    fi
    sleep 1
  done
  err "frontend slow to bind. Tail $FRONT_LOG:"
  tail -n 40 "$FRONT_LOG" || true
}

stop_one() {
  local name="$1" pidfile="$2"
  if _running "$pidfile"; then
    local pid; pid=$(cat "$pidfile")
    kill -TERM -- -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    sleep 1
    kill -KILL -- -"$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    rm -f "$pidfile"
    ok "$name stopped"
  else
    info "$name not running"
  fi
}

stop_all() {
  stop_one backend  "$BACK_PIDFILE"
  stop_one frontend "$FRONT_PIDFILE"
  pkill -f "jobscraper serve" 2>/dev/null || true
  pkill -f "next dev"        2>/dev/null || true
}

status() {
  if _running "$BACK_PIDFILE";  then ok "backend  pid $(cat $BACK_PIDFILE)  http://127.0.0.1:8000"; else err "backend down"; fi
  if _running "$FRONT_PIDFILE"; then ok "frontend pid $(cat $FRONT_PIDFILE) http://127.0.0.1:3000"; else err "frontend down"; fi
  for k in ADZUNA_APP_ID ADZUNA_APP_KEY GEMINI_API_KEY RAPIDAPI_KEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID; do
    if [ -n "${!k:-}" ]; then ok "$k set"; else err "$k missing"; fi
  done
}

_lan_ip() {
  # First non-loopback IPv4 we can find.
  if command -v ip >/dev/null 2>&1; then
    ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
  elif command -v hostname >/dev/null 2>&1; then
    hostname -I 2>/dev/null | awk '{print $1}'
  fi
}

# LAN mode: bind 0.0.0.0 so the iPad / other devices on the same Wi-Fi can
# hit the dev servers directly. Prints the URL + a QR if `qrencode` is on PATH.
run_lan() {
  stop_all >/dev/null 2>&1 || true
  _check_venv
  if [ ! -d "$ROOT/web/node_modules" ]; then
    info "installing web deps (first run)…"
    ( cd "$ROOT/web" && npm install --silent )
  fi
  local ip; ip=$(_lan_ip)
  if [ -z "$ip" ]; then
    err "could not detect LAN IP. Plug into Wi-Fi/Ethernet and retry."
    exit 1
  fi
  info "starting backend + frontend on 0.0.0.0 (Ctrl-C to stop)"
  : > "$BACK_LOG"; : > "$FRONT_LOG"

  ( cd "$ROOT/scraper" && exec .venv/bin/jobscraper serve --host 0.0.0.0 --port 8000 ) \
      > >(tee -a "$BACK_LOG"  | sed -u "s/^/$(printf '\033[35m[back] \033[0m')/") 2>&1 &
  BACK_PID=$!
  echo $BACK_PID > "$BACK_PIDFILE"

  ( cd "$ROOT/web" && exec npm run dev ) \
      > >(tee -a "$FRONT_LOG" | sed -u "s/^/$(printf '\033[36m[front]\033[0m')/") 2>&1 &
  FRONT_PID=$!
  echo $FRONT_PID > "$FRONT_PIDFILE"

  cleanup() {
    echo
    info "stopping..."
    kill -TERM "$BACK_PID"  2>/dev/null || true
    kill -TERM "$FRONT_PID" 2>/dev/null || true
    sleep 1
    kill -KILL "$BACK_PID"  2>/dev/null || true
    kill -KILL "$FRONT_PID" 2>/dev/null || true
    pkill -f "jobscraper serve" 2>/dev/null || true
    pkill -f "next dev"         2>/dev/null || true
    rm -f "$BACK_PIDFILE" "$FRONT_PIDFILE"
    ok "stopped"
    exit 0
  }
  trap cleanup INT TERM

  ( for i in $(seq 1 25); do
      if curl -sf "http://127.0.0.1:8000/api/health" > /dev/null; then break; fi
      sleep 1
    done
    for i in $(seq 1 60); do
      if curl -sf "http://127.0.0.1:3000" > /dev/null; then break; fi
      sleep 1
    done
    echo
    color "32" "═══════════════════════════════════════════"; echo
    color "32" "  LAN ready — open on iPad / other device:"; echo
    color "36" "  http://$ip:3000"; echo
    color "33" "  (same Wi-Fi as this laptop. Excalidraw supports Apple Pencil & touch.)"; echo
    if command -v qrencode >/dev/null 2>&1; then
      qrencode -t ANSIUTF8 "http://$ip:3000"
    else
      info "tip: install qrencode for a scannable QR (pacman -S qrencode)"
    fi
    color "33" "  if iPad can't connect: open ports 3000 + 8000 in your firewall."; echo
    color "32" "═══════════════════════════════════════════"; echo
  ) &

  wait $BACK_PID $FRONT_PID
  cleanup
}

# Foreground: run both, stream prefixed logs, Ctrl-C kills both cleanly.
# Uses temp FIFOs so we can sed-prefix each stream and interleave to stdout.
run_foreground() {
  stop_all >/dev/null 2>&1 || true
  _check_venv
  if [ ! -d "$ROOT/web/node_modules" ]; then
    info "installing web deps (first run)…"
    ( cd "$ROOT/web" && npm install --silent )
  fi

  info "starting backend + frontend (foreground, Ctrl-C to stop)"
  : > "$BACK_LOG"; : > "$FRONT_LOG"

  # Launch both, tee output to files AND to prefixed stdout.
  ( cd "$ROOT/scraper" && exec .venv/bin/jobscraper serve --host 127.0.0.1 --port 8000 ) \
      > >(tee -a "$BACK_LOG"  | sed -u "s/^/$(printf '\033[35m[back] \033[0m')/") 2>&1 &
  BACK_PID=$!
  echo $BACK_PID > "$BACK_PIDFILE"

  ( cd "$ROOT/web" && exec npm run dev ) \
      > >(tee -a "$FRONT_LOG" | sed -u "s/^/$(printf '\033[36m[front]\033[0m')/") 2>&1 &
  FRONT_PID=$!
  echo $FRONT_PID > "$FRONT_PIDFILE"

  cleanup() {
    echo
    info "stopping..."
    kill -TERM "$BACK_PID"  2>/dev/null || true
    kill -TERM "$FRONT_PID" 2>/dev/null || true
    sleep 1
    kill -KILL "$BACK_PID"  2>/dev/null || true
    kill -KILL "$FRONT_PID" 2>/dev/null || true
    pkill -f "jobscraper serve" 2>/dev/null || true
    pkill -f "next dev"         2>/dev/null || true
    rm -f "$BACK_PIDFILE" "$FRONT_PIDFILE"
    ok "stopped"
    exit 0
  }
  trap cleanup INT TERM

  # Heads-up once backend health passes.
  ( for i in $(seq 1 20); do
      if curl -sf http://127.0.0.1:8000/api/health > /dev/null; then
        printf "\033[32m✓ backend  http://127.0.0.1:8000\033[0m\n"; break
      fi
      sleep 1
    done
    for i in $(seq 1 45); do
      if curl -sf http://127.0.0.1:3000 > /dev/null; then
        printf "\033[32m✓ frontend http://127.0.0.1:3000\033[0m\n"; break
      fi
      sleep 1
    done ) &

  wait $BACK_PID $FRONT_PID
  cleanup
}

cmd="${1:-up}"
sub="${2:-}"
case "$cmd" in
  up|start)
    if [ "$sub" = "--bg" ] || [ "$sub" = "-d" ]; then
      start_backend_bg; start_frontend_bg; status
    else
      run_foreground
    fi
    ;;
  lan)         run_lan ;;
  down|stop)   stop_all ;;
  restart)     stop_all; start_backend_bg; start_frontend_bg; status ;;
  status)      status ;;
  logs)        tail -n 50 -f "$BACK_LOG" "$FRONT_LOG" ;;
  logs:back)   tail -n 100 -f "$BACK_LOG" ;;
  logs:front)  tail -n 100 -f "$FRONT_LOG" ;;
  open)        xdg-open http://127.0.0.1:3000 >/dev/null 2>&1 || open http://127.0.0.1:3000 ;;
  *)           echo "Usage: ./run [up [--bg]|lan|down|restart|status|logs|logs:back|logs:front|open]"; exit 1 ;;
esac
